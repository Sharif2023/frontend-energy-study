{"ast":null,"code":"export default {\n  name: 'About'\n};","map":{"version":3,"names":["name"],"sources":["F:\\frontend-energy-study\\apps\\vue\\src\\views\\About.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <div class=\"about-page\">\r\n      <h1>About</h1>\r\n      <p>\r\n        This application is part of a research study on energy consumption comparison\r\n        of modern JavaScript frameworks: React, Vue, Angular, and Svelte.\r\n      </p>\r\n      <h2>Research Objectives</h2>\r\n      <ul>\r\n        <li>Measure energy consumption across different frameworks</li>\r\n        <li>Analyze performance metrics (render time, memory usage, DOM mutations)</li>\r\n        <li>Compare framework efficiency at different workload scales</li>\r\n        <li>Provide empirical data for green computing practices</li>\r\n      </ul>\r\n      <h2>Methodology</h2>\r\n      <p>\r\n        The study uses RAPL-compatible tools (Scaphandre, Joulemeter, or external power meters)\r\n        to collect energy measurements. Test applications are built identically across all frameworks\r\n        to ensure fair comparison.\r\n      </p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'About'\r\n}\r\n</script>\r\n"],"mappings":"AA0BA,eAAe;EACbA,IAAI,EAAE;AACR","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}