{"ast":null,"code":"import { ref, computed } from 'vue';\nexport default {\n  name: 'ItemList',\n  props: {\n    items: {\n      type: Array,\n      default: () => []\n    }\n  },\n  emits: ['add-items', 'remove-items'],\n  setup(props, {\n    emit\n  }) {\n    const filterQuery = ref('');\n    const sortBy = ref('id');\n    const addAmount = ref(100);\n    const filteredAndSortedItems = computed(() => {\n      let result = [...props.items];\n      if (filterQuery.value) {\n        result = result.filter(item => item.name.toLowerCase().includes(filterQuery.value.toLowerCase()));\n      }\n      if (sortBy.value === 'name') {\n        result.sort((a, b) => a.name.localeCompare(b.name));\n      } else {\n        result.sort((a, b) => a.id - b.id);\n      }\n      return result;\n    });\n    const handleAdd = () => {\n      emit('add-items', addAmount.value);\n    };\n    const handleRemove = () => {\n      emit('remove-items', 50);\n    };\n    const handleFilter = () => {\n      filterQuery.value = filterQuery.value === 'item' ? '' : 'item';\n    };\n    const handleSort = () => {\n      sortBy.value = sortBy.value === 'id' ? 'name' : 'id';\n    };\n    return {\n      filterQuery,\n      sortBy,\n      addAmount,\n      filteredAndSortedItems,\n      handleAdd,\n      handleRemove,\n      handleFilter,\n      handleSort\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","name","props","items","type","Array","default","emits","setup","emit","filterQuery","sortBy","addAmount","filteredAndSortedItems","result","value","filter","item","toLowerCase","includes","sort","a","b","localeCompare","id","handleAdd","handleRemove","handleFilter","handleSort"],"sources":["F:\\frontend-energy-study\\apps\\vue\\src\\components\\ItemList.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"controls\">\r\n      <input\r\n        id=\"item-input\"\r\n        type=\"number\"\r\n        v-model.number=\"addAmount\"\r\n        min=\"10\"\r\n        max=\"500\"\r\n      />\r\n      <button id=\"add-btn\" @click=\"handleAdd\">Add {{ addAmount }} Items</button>\r\n      <button id=\"remove-btn\" @click=\"handleRemove\">Remove 50 Items</button>\r\n      <button id=\"filter-btn\" @click=\"handleFilter\">\r\n        {{ filterQuery ? 'Clear Filter' : 'Filter \"Item\"' }}\r\n      </button>\r\n      <button id=\"sort-btn\" @click=\"handleSort\">\r\n        Sort by {{ sortBy === 'id' ? 'Name' : 'ID' }}\r\n      </button>\r\n    </div>\r\n\r\n    <div class=\"item-list\">\r\n      <h3>\r\n        Dynamic Items (<span id=\"list-count\">{{ filteredAndSortedItems.length }}</span>)\r\n      </h3>\r\n      <ul id=\"item-list\">\r\n        <li v-for=\"item in filteredAndSortedItems\" :key=\"item.id\" class=\"item\">\r\n          <span>ID: {{ item.id }}</span>\r\n          <span>{{ item.name }}</span>\r\n        </li>\r\n      </ul>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\n\r\nexport default {\r\n  name: 'ItemList',\r\n  props: {\r\n    items: {\r\n      type: Array,\r\n      default: () => []\r\n    }\r\n  },\r\n  emits: ['add-items', 'remove-items'],\r\n  setup(props, { emit }) {\r\n    const filterQuery = ref('')\r\n    const sortBy = ref('id')\r\n    const addAmount = ref(100)\r\n\r\n    const filteredAndSortedItems = computed(() => {\r\n      let result = [...props.items]\r\n\r\n      if (filterQuery.value) {\r\n        result = result.filter(item =>\r\n          item.name.toLowerCase().includes(filterQuery.value.toLowerCase())\r\n        )\r\n      }\r\n\r\n      if (sortBy.value === 'name') {\r\n        result.sort((a, b) => a.name.localeCompare(b.name))\r\n      } else {\r\n        result.sort((a, b) => a.id - b.id)\r\n      }\r\n\r\n      return result\r\n    })\r\n\r\n    const handleAdd = () => {\r\n      emit('add-items', addAmount.value)\r\n    }\r\n\r\n    const handleRemove = () => {\r\n      emit('remove-items', 50)\r\n    }\r\n\r\n    const handleFilter = () => {\r\n      filterQuery.value = filterQuery.value === 'item' ? '' : 'item'\r\n    }\r\n\r\n    const handleSort = () => {\r\n      sortBy.value = sortBy.value === 'id' ? 'name' : 'id'\r\n    }\r\n\r\n    return {\r\n      filterQuery,\r\n      sortBy,\r\n      addAmount,\r\n      filteredAndSortedItems,\r\n      handleAdd,\r\n      handleRemove,\r\n      handleFilter,\r\n      handleSort\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAmCA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAElC,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,KAAK;MACXC,OAAO,EAAEA,CAAA,KAAM;IACjB;EACF,CAAC;EACDC,KAAK,EAAE,CAAC,WAAW,EAAE,cAAc,CAAC;EACpCC,KAAKA,CAACN,KAAK,EAAE;IAAEO;EAAK,CAAC,EAAE;IACrB,MAAMC,WAAU,GAAIX,GAAG,CAAC,EAAE;IAC1B,MAAMY,MAAK,GAAIZ,GAAG,CAAC,IAAI;IACvB,MAAMa,SAAQ,GAAIb,GAAG,CAAC,GAAG;IAEzB,MAAMc,sBAAqB,GAAIb,QAAQ,CAAC,MAAM;MAC5C,IAAIc,MAAK,GAAI,CAAC,GAAGZ,KAAK,CAACC,KAAK;MAE5B,IAAIO,WAAW,CAACK,KAAK,EAAE;QACrBD,MAAK,GAAIA,MAAM,CAACE,MAAM,CAACC,IAAG,IACxBA,IAAI,CAAChB,IAAI,CAACiB,WAAW,CAAC,CAAC,CAACC,QAAQ,CAACT,WAAW,CAACK,KAAK,CAACG,WAAW,CAAC,CAAC,CAClE;MACF;MAEA,IAAIP,MAAM,CAACI,KAAI,KAAM,MAAM,EAAE;QAC3BD,MAAM,CAACM,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKD,CAAC,CAACpB,IAAI,CAACsB,aAAa,CAACD,CAAC,CAACrB,IAAI,CAAC;MACpD,OAAO;QACLa,MAAM,CAACM,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKD,CAAC,CAACG,EAAC,GAAIF,CAAC,CAACE,EAAE;MACnC;MAEA,OAAOV,MAAK;IACd,CAAC;IAED,MAAMW,SAAQ,GAAIA,CAAA,KAAM;MACtBhB,IAAI,CAAC,WAAW,EAAEG,SAAS,CAACG,KAAK;IACnC;IAEA,MAAMW,YAAW,GAAIA,CAAA,KAAM;MACzBjB,IAAI,CAAC,cAAc,EAAE,EAAE;IACzB;IAEA,MAAMkB,YAAW,GAAIA,CAAA,KAAM;MACzBjB,WAAW,CAACK,KAAI,GAAIL,WAAW,CAACK,KAAI,KAAM,MAAK,GAAI,EAAC,GAAI,MAAK;IAC/D;IAEA,MAAMa,UAAS,GAAIA,CAAA,KAAM;MACvBjB,MAAM,CAACI,KAAI,GAAIJ,MAAM,CAACI,KAAI,KAAM,IAAG,GAAI,MAAK,GAAI,IAAG;IACrD;IAEA,OAAO;MACLL,WAAW;MACXC,MAAM;MACNC,SAAS;MACTC,sBAAsB;MACtBY,SAAS;MACTC,YAAY;MACZC,YAAY;MACZC;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}