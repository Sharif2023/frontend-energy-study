{"ast":null,"code":"import { ref, reactive } from 'vue';\nexport default {\n  name: 'Contact',\n  setup() {\n    const formData = reactive({\n      name: '',\n      email: '',\n      message: ''\n    });\n    const errors = ref({});\n    const submitted = ref(false);\n    const validate = () => {\n      const newErrors = {};\n      if (!formData.name.trim()) {\n        newErrors.name = 'Name is required';\n      }\n      if (!formData.email.trim()) {\n        newErrors.email = 'Email is required';\n      } else if (!/\\S+@\\S+\\.\\S+/.test(formData.email)) {\n        newErrors.email = 'Email is invalid';\n      }\n      if (!formData.message.trim()) {\n        newErrors.message = 'Message is required';\n      }\n      errors.value = newErrors;\n      return Object.keys(newErrors).length === 0;\n    };\n    const handleSubmit = () => {\n      if (validate()) {\n        console.log('Form submitted:', formData);\n        submitted.value = true;\n        Object.assign(formData, {\n          name: '',\n          email: '',\n          message: ''\n        });\n        setTimeout(() => {\n          submitted.value = false;\n        }, 5000);\n      }\n    };\n    return {\n      formData,\n      errors,\n      submitted,\n      handleSubmit\n    };\n  }\n};","map":{"version":3,"names":["ref","reactive","name","setup","formData","email","message","errors","submitted","validate","newErrors","trim","test","value","Object","keys","length","handleSubmit","console","log","assign","setTimeout"],"sources":["F:\\frontend-energy-study\\apps\\vue\\src\\views\\Contact.vue"],"sourcesContent":["<template>\r\n  <div class=\"page\">\r\n    <div class=\"contact-page\">\r\n      <h1>Contact</h1>\r\n      <form class=\"contact-form\" @submit.prevent=\"handleSubmit\">\r\n        <div>\r\n          <input\r\n            type=\"text\"\r\n            name=\"name\"\r\n            placeholder=\"Your Name\"\r\n            v-model=\"formData.name\"\r\n            :class=\"{ error: errors.name }\"\r\n          />\r\n          <div v-if=\"errors.name\" class=\"error-message\">{{ errors.name }}</div>\r\n        </div>\r\n\r\n        <div>\r\n          <input\r\n            type=\"email\"\r\n            name=\"email\"\r\n            placeholder=\"Your Email\"\r\n            v-model=\"formData.email\"\r\n            :class=\"{ error: errors.email }\"\r\n          />\r\n          <div v-if=\"errors.email\" class=\"error-message\">{{ errors.email }}</div>\r\n        </div>\r\n\r\n        <div>\r\n          <textarea\r\n            name=\"message\"\r\n            placeholder=\"Your Message\"\r\n            rows=\"5\"\r\n            v-model=\"formData.message\"\r\n            :class=\"{ error: errors.message }\"\r\n          />\r\n          <div v-if=\"errors.message\" class=\"error-message\">{{ errors.message }}</div>\r\n        </div>\r\n\r\n        <button type=\"submit\">Send Message</button>\r\n        <div v-if=\"submitted\" class=\"success-message\">Message sent successfully!</div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive } from 'vue'\r\n\r\nexport default {\r\n  name: 'Contact',\r\n  setup() {\r\n    const formData = reactive({\r\n      name: '',\r\n      email: '',\r\n      message: ''\r\n    })\r\n    const errors = ref({})\r\n    const submitted = ref(false)\r\n\r\n    const validate = () => {\r\n      const newErrors = {}\r\n\r\n      if (!formData.name.trim()) {\r\n        newErrors.name = 'Name is required'\r\n      }\r\n\r\n      if (!formData.email.trim()) {\r\n        newErrors.email = 'Email is required'\r\n      } else if (!/\\S+@\\S+\\.\\S+/.test(formData.email)) {\r\n        newErrors.email = 'Email is invalid'\r\n      }\r\n\r\n      if (!formData.message.trim()) {\r\n        newErrors.message = 'Message is required'\r\n      }\r\n\r\n      errors.value = newErrors\r\n      return Object.keys(newErrors).length === 0\r\n    }\r\n\r\n    const handleSubmit = () => {\r\n      if (validate()) {\r\n        console.log('Form submitted:', formData)\r\n        submitted.value = true\r\n        Object.assign(formData, { name: '', email: '', message: '' })\r\n        setTimeout(() => {\r\n          submitted.value = false\r\n        }, 5000)\r\n      }\r\n    }\r\n\r\n    return {\r\n      formData,\r\n      errors,\r\n      submitted,\r\n      handleSubmit\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AA8CA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAElC,eAAe;EACbC,IAAI,EAAE,SAAS;EACfC,KAAKA,CAAA,EAAG;IACN,MAAMC,QAAO,GAAIH,QAAQ,CAAC;MACxBC,IAAI,EAAE,EAAE;MACRG,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX,CAAC;IACD,MAAMC,MAAK,GAAIP,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMQ,SAAQ,GAAIR,GAAG,CAAC,KAAK;IAE3B,MAAMS,QAAO,GAAIA,CAAA,KAAM;MACrB,MAAMC,SAAQ,GAAI,CAAC;MAEnB,IAAI,CAACN,QAAQ,CAACF,IAAI,CAACS,IAAI,CAAC,CAAC,EAAE;QACzBD,SAAS,CAACR,IAAG,GAAI,kBAAiB;MACpC;MAEA,IAAI,CAACE,QAAQ,CAACC,KAAK,CAACM,IAAI,CAAC,CAAC,EAAE;QAC1BD,SAAS,CAACL,KAAI,GAAI,mBAAkB;MACtC,OAAO,IAAI,CAAC,cAAc,CAACO,IAAI,CAACR,QAAQ,CAACC,KAAK,CAAC,EAAE;QAC/CK,SAAS,CAACL,KAAI,GAAI,kBAAiB;MACrC;MAEA,IAAI,CAACD,QAAQ,CAACE,OAAO,CAACK,IAAI,CAAC,CAAC,EAAE;QAC5BD,SAAS,CAACJ,OAAM,GAAI,qBAAoB;MAC1C;MAEAC,MAAM,CAACM,KAAI,GAAIH,SAAQ;MACvB,OAAOI,MAAM,CAACC,IAAI,CAACL,SAAS,CAAC,CAACM,MAAK,KAAM;IAC3C;IAEA,MAAMC,YAAW,GAAIA,CAAA,KAAM;MACzB,IAAIR,QAAQ,CAAC,CAAC,EAAE;QACdS,OAAO,CAACC,GAAG,CAAC,iBAAiB,EAAEf,QAAQ;QACvCI,SAAS,CAACK,KAAI,GAAI,IAAG;QACrBC,MAAM,CAACM,MAAM,CAAChB,QAAQ,EAAE;UAAEF,IAAI,EAAE,EAAE;UAAEG,KAAK,EAAE,EAAE;UAAEC,OAAO,EAAE;QAAG,CAAC;QAC5De,UAAU,CAAC,MAAM;UACfb,SAAS,CAACK,KAAI,GAAI,KAAI;QACxB,CAAC,EAAE,IAAI;MACT;IACF;IAEA,OAAO;MACLT,QAAQ;MACRG,MAAM;MACNC,SAAS;MACTS;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}