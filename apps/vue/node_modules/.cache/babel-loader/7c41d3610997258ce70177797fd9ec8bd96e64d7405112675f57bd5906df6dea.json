{"ast":null,"code":"import { ref, watch } from 'vue';\nimport { store } from '../store';\nexport default {\n  name: 'WeatherWidget',\n  setup() {\n    const weatherData = ref(null);\n    const loading = ref(true);\n    const error = ref(null);\n    const fetchWeather = async () => {\n      loading.value = true;\n      error.value = null;\n      try {\n        // Mock weather API call\n        await new Promise(resolve => setTimeout(resolve, 500));\n        const mockWeather = {\n          name: 'London',\n          main: {\n            temp: (Math.random() * 30 + 10).toFixed(1),\n            humidity: Math.floor(Math.random() * 40 + 40)\n          },\n          weather: [{\n            description: ['sunny', 'cloudy', 'rainy', 'clear'][Math.floor(Math.random() * 4)]\n          }]\n        };\n        weatherData.value = mockWeather;\n      } catch (err) {\n        error.value = 'Failed to fetch weather';\n        console.error('Weather API error:', err);\n      } finally {\n        loading.value = false;\n      }\n    };\n    watch(() => store.widgetRefreshCounter, () => {\n      fetchWeather();\n    }, {\n      immediate: true\n    });\n    return {\n      weatherData,\n      loading,\n      error\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","store","name","setup","weatherData","loading","error","fetchWeather","value","Promise","resolve","setTimeout","mockWeather","main","temp","Math","random","toFixed","humidity","floor","weather","description","err","console","widgetRefreshCounter","immediate"],"sources":["F:\\frontend-energy-study\\apps\\vue\\src\\components\\WeatherWidget.vue"],"sourcesContent":["<template>\r\n  <div class=\"widget weather\">\r\n    <h3>Weather</h3>\r\n    <div id=\"weather-data\">\r\n      <div v-if=\"loading\">Loading...</div>\r\n      <div v-else-if=\"error\">{{ error }}</div>\r\n      <div v-else-if=\"weatherData\">\r\n        <div><strong>{{ weatherData.name }}</strong></div>\r\n        <div>Temp: {{ weatherData.main.temp }}°C</div>\r\n        <div>Humidity: {{ weatherData.main.humidity }}%</div>\r\n        <div>{{ weatherData.weather[0].description }}</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch } from 'vue'\r\nimport { store } from '../store'\r\n\r\nexport default {\r\n  name: 'WeatherWidget',\r\n  setup() {\r\n    const weatherData = ref(null)\r\n    const loading = ref(true)\r\n    const error = ref(null)\r\n\r\n    const fetchWeather = async () => {\r\n      loading.value = true\r\n      error.value = null\r\n\r\n      try {\r\n        // Mock weather API call\r\n        await new Promise(resolve => setTimeout(resolve, 500))\r\n\r\n        const mockWeather = {\r\n          name: 'London',\r\n          main: {\r\n            temp: (Math.random() * 30 + 10).toFixed(1),\r\n            humidity: Math.floor(Math.random() * 40 + 40)\r\n          },\r\n          weather: [{\r\n            description: ['sunny', 'cloudy', 'rainy', 'clear'][Math.floor(Math.random() * 4)]\r\n          }]\r\n        }\r\n\r\n        weatherData.value = mockWeather\r\n      } catch (err) {\r\n        error.value = 'Failed to fetch weather'\r\n        console.error('Weather API error:', err)\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    watch(() => store.widgetRefreshCounter, () => {\r\n      fetchWeather()\r\n    }, { immediate: true })\r\n\r\n    return {\r\n      weatherData,\r\n      loading,\r\n      error\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAiBA,SAASA,GAAG,EAAEC,KAAI,QAAS,KAAI;AAC/B,SAASC,KAAI,QAAS,UAAS;AAE/B,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,KAAKA,CAAA,EAAG;IACN,MAAMC,WAAU,GAAIL,GAAG,CAAC,IAAI;IAC5B,MAAMM,OAAM,GAAIN,GAAG,CAAC,IAAI;IACxB,MAAMO,KAAI,GAAIP,GAAG,CAAC,IAAI;IAEtB,MAAMQ,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/BF,OAAO,CAACG,KAAI,GAAI,IAAG;MACnBF,KAAK,CAACE,KAAI,GAAI,IAAG;MAEjB,IAAI;QACF;QACA,MAAM,IAAIC,OAAO,CAACC,OAAM,IAAKC,UAAU,CAACD,OAAO,EAAE,GAAG,CAAC;QAErD,MAAME,WAAU,GAAI;UAClBV,IAAI,EAAE,