{"ast":null,"code":"import { ref, watch, onMounted } from 'vue';\nimport { store } from '../store';\nexport default {\n  name: 'PlaceholderWidget',\n  props: {\n    id: {\n      type: Number,\n      required: true\n    }\n  },\n  setup(props) {\n    const colors = ['#ff6b6b', '#4ecdc4', '#45b7d1', '#f9ca24', '#f0932b', '#eb4d4b', '#6c5ce7', '#a29bfe'];\n    const color = colors[props.id % colors.length];\n    const number = ref(Math.floor(Math.random() * 1000));\n    const updateNumber = () => {\n      number.value = Math.floor(Math.random() * 1000);\n    };\n    watch(() => store.widgetRefreshCounter, () => {\n      updateNumber();\n    });\n    onMounted(() => {\n      updateNumber();\n    });\n    return {\n      color,\n      number\n    };\n  }\n};","map":{"version":3,"names":["ref","watch","onMounted","store","name","props","id","type","Number","required","setup","colors","color","length","number","Math","floor","random","updateNumber","value","widgetRefreshCounter"],"sources":["F:\\frontend-energy-study\\apps\\vue\\src\\components\\PlaceholderWidget.vue"],"sourcesContent":["<template>\r\n  <div \r\n    class=\"widget\" \r\n    :data-id=\"id\" \r\n    :style=\"{ borderTop: `4px solid ${color}` }\"\r\n  >\r\n    <h3>Widget {{ id }}</h3>\r\n    <div :style=\"{ fontSize: '32px', fontWeight: 'bold', color }\">\r\n      {{ number }}\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, watch, onMounted } from 'vue'\r\nimport { store } from '../store'\r\n\r\nexport default {\r\n  name: 'PlaceholderWidget',\r\n  props: {\r\n    id: {\r\n      type: Number,\r\n      required: true\r\n    }\r\n  },\r\n  setup(props) {\r\n    const colors = ['#ff6b6b', '#4ecdc4', '#45b7d1', '#f9ca24', '#f0932b', '#eb4d4b', '#6c5ce7', '#a29bfe']\r\n    const color = colors[props.id % colors.length]\r\n    const number = ref(Math.floor(Math.random() * 1000))\r\n\r\n    const updateNumber = () => {\r\n      number.value = Math.floor(Math.random() * 1000)\r\n    }\r\n\r\n    watch(() => store.widgetRefreshCounter, () => {\r\n      updateNumber()\r\n    })\r\n\r\n    onMounted(() => {\r\n      updateNumber()\r\n    })\r\n\r\n    return {\r\n      color,\r\n      number\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAcA,SAASA,GAAG,EAAEC,KAAK,EAAEC,SAAQ,QAAS,KAAI;AAC1C,SAASC,KAAI,QAAS,UAAS;AAE/B,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,KAAK,EAAE;IACLC,EAAE,EAAE;MACFC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,KAAKA,CAACL,KAAK,EAAE;IACX,MAAMM,MAAK,GAAI,CAAC,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS;IACtG,MAAMC,KAAI,GAAID,MAAM,CAACN,KAAK,CAACC,EAAC,GAAIK,MAAM,CAACE,MAAM;IAC7C,MAAMC,MAAK,GAAId,GAAG,CAACe,IAAI,CAACC,KAAK,CAACD,IAAI,CAACE,MAAM,CAAC,IAAI,IAAI,CAAC;IAEnD,MAAMC,YAAW,GAAIA,CAAA,KAAM;MACzBJ,MAAM,CAACK,KAAI,GAAIJ,IAAI,CAACC,KAAK,CAACD,IAAI,CAACE,MAAM,CAAC,IAAI,IAAI;IAChD;IAEAhB,KAAK,CAAC,MAAME,KAAK,CAACiB,oBAAoB,EAAE,MAAM;MAC5CF,YAAY,CAAC;IACf,CAAC;IAEDhB,SAAS,CAAC,MAAM;MACdgB,YAAY,CAAC;IACf,CAAC;IAED,OAAO;MACLN,KAAK;MACLE;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}